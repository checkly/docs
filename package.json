{
  "name": "checkly-docs-monitoring",
  "version": "1.0.0",
  "description": "Monitoring setup for Checkly documentation site",
  "main": "checkly.config.ts",
  "scripts": {
    "dev": "mint dev",
    "deploy": "checkly deploy",
    "test": "checkly test",
    "trigger": "checkly trigger",
    "login": "checkly login",
    "generate-sitemap": "node .github/scripts/generate-sitemap.mjs",
    "lint:docs": "python3 .github/scripts/check_frontmatter.py && python3 .github/scripts/check_content_quality.py && npx mint broken-links && npx mint a11y",
    "lint:docs:baseline": "python3 .github/scripts/check_content_quality.py --update-baseline"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "checkly": "8.2.0",
    "mint": "4.2.259",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "checkly",
    "monitoring",
    "documentation",
    "testing"
  ],
  "author": "Checkly Team",
  "license": "MIT"
}
